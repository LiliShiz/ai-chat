# Скопируйте этот файл в .env и впишите свой ключ.
# .env в .gitignore — ключ не попадает ни в репозиторий, ни в бандл фронта.

# Ключ с https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...

# Любая модель с суффиксом :free из каталога https://openrouter.ai/models?q=free
OPENROUTER_MODEL=deepseek/deepseek-chat-v3-0324:free

# Порт прокси (фронт в dev ходит сюда через Vite-прокси)
PORT=8787

# Таймауты, мс: ожидание первого токена и пауза между токенами
FIRST_TOKEN_TIMEOUT_MS=45000
IDLE_TIMEOUT_MS=30000
