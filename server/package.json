{
  "name": "server",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node --watch --import tsx --env-file-if-exists=../.env src/index.ts",
    "start": "cross-env NODE_ENV=production tsx --env-file-if-exists=../.env src/index.ts",
    "mock": "tsx src/dev/mock-upstream.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.8",
    "hono": "^4.7.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.5",
    "cross-env": "^10.1.0",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^3.2.7"
  }
}
